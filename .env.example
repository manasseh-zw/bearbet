DATABASE_URL=postgresql://bearbet:bearbet_local@localhost:5432/bearbet
BETTER_AUTH_SECRET=replace-with-a-generated-secret
BETTER_AUTH_URL=http://localhost:3000

# The normal submission path uses the BigBang Standard sandbox provider.
CASINO_PROVIDER=bigbang
BIGBANG_BASE_URL=https://api.bigbangcasino.bet/
BIGBANG_SANDBOX_KEY=
# The authenticated game close action records only the provider's net session delta.
BIGBANG_SANDBOX_RECONCILIATION=true

# Drakon credentials are server-only and are only needed when switching providers.
DRAKON_AGENT_CODE=
DRAKON_AGENT_TOKEN=
DRAKON_AGENT_SECRET=
DRAKON_WEBHOOK_KEY=
DRAKON_MODE=fun
DRAKON_BASE_URL=https://gator.drakon.casino/api/v1/
FIXTURE_PROVIDER_DELAY_MS=0
FIXTURE_PROVIDER_FAILURE=none
